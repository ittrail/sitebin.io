# Copy to .env and fill in. Nothing here is committed with a real value.
#
#   cp .env.example .env && docker compose up -d --build

# ---- the licence roots, baked into the image at BUILD time ----
# The stack's trusted root PUBLIC keys, base64, comma-separated -- the LIST
# an app bakes in, so a root can be rotated without a rebuild. Documented way
# to get it, with the platform admin key:
#   curl -H "Authorization: Bearer $PLATFORM_ADMIN_KEY" \
#     http://platform.saas-stack.saas.localtest.me:8080/api/v1/licensing/trusted-public-keys
# and join `public_keys` with commas. The admin portal offers the same under
# Settings -> licence root public key.
LICENSE_ROOTS=

# ---- serving ----
# One port, used everywhere: the base domain, the OIDC redirect URI and the
# MCP resource URL are all built from it, and the stack is told exactly these.
SITEBIN_PORT=8091
SITEBIN_BASE_DOMAIN=sitebin.localtest.me:8091

# ---- the docker network the running stack is on ----
# Discovery through the Auth Gateway hands back Keycloak's INTERNAL back-channel
# URLs (http://keycloak:8080/...), so this container has to be on the stack's
# own network to resolve them. `docker network ls` on the stack host.
STACK_NETWORK=docker_compose_pkg_dev_default

# ---- the stack's Auth Gateway (OIDC) ----
# ISSUER is the realm -- the value every token's `iss` carries. It is NOT the
# gateway, and it did not change meaning when the discovery URL was added.
SITEBIN_OAUTH_OIDC_ISSUER=http://auth.saas.localtest.me:8080/realms/saas-stack
# DISCOVERY_URL is the Auth Gateway, and it is what puts sign-in behind the
# stack's CONSENT GATE. Point it at Keycloak instead and the gate is bypassed
# silently: sign-in works, nobody is ever asked to accept anything.
SITEBIN_OAUTH_OIDC_DISCOVERY_URL=http://auth-gw.saas-stack.saas.localtest.me:8080/api/v1/sitebin
SITEBIN_OAUTH_OIDC_CLIENT_ID=sitebin-app
# Returned as `auth.client.secret` by EVERY registration, so run the
# self-registration once (or POST /api/v1/apps yourself) and copy it here.
SITEBIN_OAUTH_OIDC_CLIENT_SECRET=
SITEBIN_OAUTH_OIDC_LABEL=Sign in with IT-Trail

# ---- PayGate ----
# The public URL through the stack's Traefik; extra_hosts in the compose file
# sends it to the host. `http://paygate:3001` works too from inside the
# stack's network.
SITEBIN_PAYGATE_URL=http://paygate.saas-stack.saas.localtest.me:8080
SITEBIN_PAYGATE_APP_ID=sitebin
# The app's own key (ssk_...), returned ONCE by the first registration. Lost
# it? Revoke and reissue through the platform API's api-keys routes.
SITEBIN_PAYGATE_API_KEY=

# ---- self-registration with the stack ----
# All three together or none. The admin key acts on EVERY app on the stack;
# it belongs only on an instance you operate yourself.
SITEBIN_STACK_URL=http://platform.saas-stack.saas.localtest.me:8080
SITEBIN_STACK_APP_ID=sitebin
SITEBIN_STACK_ADMIN_KEY=
# This deployment's own consent documents, in the order the gate shows them
# after the platform's. key is the document's identity for ever; raising a
# version asks every user again for THAT document. Empty declares nothing
# (registration merges).
SITEBIN_STACK_CONSENTS=[{"key":"terms","version":"2026-09-08","url":"https://sitebin.io/terms/","title":{"en":"Sitebin Terms of Service","de":"Sitebin Nutzungsbedingungen"}},{"key":"dpa","version":"2026-09-08","url":"https://sitebin.io/dpa/","title":{"en":"Data Processing Agreement","de":"Auftragsverarbeitungsvertrag"}}]
# What a Sitebin Enterprise licence issued by this stack is worth. A plan
# absent from `plans` carries no entitlements, which means UNLIMITED.
SITEBIN_STACK_LICENSING={"graceMonths":3,"plans":{"team":{"max_custom_domains":25},"business":{"max_custom_domains":250},"platform":{}}}
# The secret the stack signs its GDPR orders with. Required here; at least
# 32 characters. Generate one:  openssl rand -hex 24
SITEBIN_STACK_GDPR_SECRET=

# ---- MCP (optional) ----
# Set to the realm issuer to accept the stack's access tokens on /mcp and to
# declare the MCP resource and scopes with the registration.
SITEBIN_MCP_OAUTH_ISSUER=http://auth.saas.localtest.me:8080/realms/saas-stack

# ---- licensing ----
# Leave empty to exercise the collect-from-the-stack path.
SITEBIN_LICENSE_KEY=
SITEBIN_LICENSE_URL=

# ---- tiers ----
SITEBIN_DEFAULT_TIER=free
