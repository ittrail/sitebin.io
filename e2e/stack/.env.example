# Copy to .env and fill in. Nothing here is committed with a real value.
#
#   cp .env.example .env && docker compose up -d --build

# ---- the licence root, baked into the image at BUILD time ----
# The stack's root PUBLIC key, base64. Download it from the stack admin portal.
# Comma-separate several while rotating.
LICENSE_ROOTS=

# ---- serving ----
SITEBIN_PORT=8091
SITEBIN_BASE_DOMAIN=sitebin.localtest.me:8091

# ---- the docker network the running stack is on ----
# Discovery through the Auth Gateway hands back Keycloak's INTERNAL back-channel
# URLs (http://keycloak:8080/...), so this container has to be on the stack's
# own network to resolve them. `docker network ls` on the stack host.
STACK_NETWORK=docker_compose_pkg_dev_default

# ---- the stack's Auth Gateway (OIDC) ----
# ISSUER is the realm -- the value every token's `iss` carries. It is NOT the
# gateway, and it did not change meaning when the discovery URL was added.
SITEBIN_OAUTH_OIDC_ISSUER=http://auth.saas.localtest.me:8080/realms/saas-stack
# DISCOVERY_URL is the Auth Gateway, and it is what puts sign-in behind the
# stack's CONSENT GATE. Point it at Keycloak instead and the gate is bypassed
# silently: sign-in works, nobody is ever asked to accept anything.
SITEBIN_OAUTH_OIDC_DISCOVERY_URL=http://auth-gw.saas-stack.saas.localtest.me:8080/api/v1/sitebin
SITEBIN_OAUTH_OIDC_CLIENT_ID=sitebin-app
SITEBIN_OAUTH_OIDC_CLIENT_SECRET=
SITEBIN_OAUTH_OIDC_LABEL=Sign in with IT-Trail

# ---- PayGate ----
SITEBIN_PAYGATE_URL=https://paygate.example.test
SITEBIN_PAYGATE_APP_ID=sitebin
SITEBIN_PAYGATE_API_KEY=
# Where "manage subscription" sends the customer on the stack.
SITEBIN_PAYGATE_MANAGE_URL=https://stack.example.test/account

# ---- optional self-registration with the stack ----
# All three together or none. The admin key acts on EVERY app on the stack;
# it belongs only on an instance you operate yourself.
SITEBIN_STACK_URL=
SITEBIN_STACK_APP_ID=
SITEBIN_STACK_ADMIN_KEY=
# This deployment's own terms of service -- the second document the consent
# gate asks for. version and url are required; raising the version asks every
# user again. Empty declares nothing (registration merges).
SITEBIN_STACK_TERMS=

# ---- licensing ----
# Leave empty to exercise the collect-from-the-stack path.
SITEBIN_LICENSE_KEY=
SITEBIN_LICENSE_URL=

# ---- tiers ----
SITEBIN_DEFAULT_TIER=free
